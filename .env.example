# Copy this file to ".env" and fill in the real values.
# ".env" is in .gitignore, so your real keys never go to GitHub.
# This example file IS committed, so teammates know which keys are needed.

GEMINI_API_KEY=paste-your-gemini-key-here
ELEVENLABS_API_KEY=paste-your-elevenlabs-key-here
ACCESS_CODE=choose-a-code-for-the-app
